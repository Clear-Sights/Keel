{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.sh",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|MultiEdit|NotebookEdit|PowerShell|Read|Write"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.sh",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "auto"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.sh",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Agent|AskUserQuestion|Bash|Edit|ExitPlanMode|Glob|Grep|MultiEdit|NotebookEdit|PowerShell|Read|Task|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.sh",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.sh",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.sh",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.sh",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.sh",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  }
}
